# Generated/fetched data — not source-controlled (size + Mapbox licensing + it's all
# reconstructible from a fresh search, none of it is hand-authored).
tiles/
embeddings/
models/
classes/
.scratch/

# oil_refinery experiments — probe/benchmark outputs, raw downloaded datasets, and the
# live-updating training status file (rewritten every epoch by the xview training run)
oil_refinery/probe/
oil_refinery/xview_raw/
oil_refinery/checkpoint_eval/
oil_refinery/training_status.txt

# Pretrained checkpoints downloaded by ultralytics/scripts on first run.
*.pt

# Secrets — seed files may get pasted with a real access_token in the URL by mistake.
.env
seeds/*.yaml
!seeds/seed_example.yaml

# Python
__pycache__/
*.pyc
.venv/

# Runtime artifacts from restart.sh / restart.ps1
app.log
app.err.log
.app.pid
train_*.log
logs/

# Editors/OS
.DS_Store
